// Inn rest: the only place that restores TP (Pokémon Centers are gone; Omar,
// 2026-10-26). Three rooms (constants/town_life.h):
//   Ume    free. HP, status and TP.
//   Take   Charisma >= INN_TAKE_CHARISMA or INN_TAKE_BADGES badges. As Ume, then a
//          healing item turns up in the room INN_TAKE_ITEM_STEPS steps later
//          (object with flag FLAG_HIDE_INN_TAKE_ITEM, counted in UpdateInnStepCounter).
//   Matsu  FLAG_INN_MATSU_OPEN (placeholder story flag). As Take, plus friendship.
//
// An innkeeper calls Common_EventScript_Inn. It returns VAR_RESULT TRUE when the
// party rested, so the caller can set its own respawn point:
//
//   script MyTown_Inn_EventScript_Keeper {
//       call(Common_EventScript_Inn)
//       if (var(VAR_RESULT) == TRUE) {
//           setrespawn(HEAL_LOCATION_MY_TOWN_INN)
//       }
//       release
//       end
//   }
//
// A whiteout wakes the player at the last respawn point, fully rested.

script Common_EventScript_Inn {
    lock
    faceplayer
    msgbox(format("Welcome! Will you be staying the night?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        goto(Inn_EventScript_Goodbye)
    }
    message(format("Which room would you like?"))
    waitmessage
    dynmultichoice(20, 4, FALSE, 4, 0, DYN_MULTICHOICE_CB_NONE, Inn_Text_RoomUme, Inn_Text_RoomTake, Inn_Text_RoomMatsu, Inn_Text_RoomCancel)
    if (var(VAR_RESULT) > INN_ROOM_MATSU) {
        goto(Inn_EventScript_Goodbye)
    }
    copyvar(VAR_0x8004, VAR_RESULT)
    special(IsInnRoomOpen)
    if (var(VAR_RESULT) == FALSE) {
        if (var(VAR_0x8004) == INN_ROOM_TAKE) {
            msgbox(format("I'm sorry, the TAKE room is for guests we know a little better. Make a name for yourself, and it's yours."))
        } else {
            msgbox(format("The MATSU room… I'm afraid it isn't open to anyone just now."))
        }
        setvar(VAR_RESULT, FALSE)
        return
    }
    msgbox(format("This way, please. Rest well."))
    closemessage
    fadescreen(FADE_TO_BLACK)
    playfanfare(MUS_HEAL)
    waitfanfare
    special(InnRest)
    fadescreen(FADE_FROM_BLACK)
    msgbox(format("Good morning! Your POKéMON look full of energy again."))
    setvar(VAR_RESULT, TRUE)
    return
}

script Inn_EventScript_Goodbye {
    msgbox(format("Come back whenever you're tired."))
    setvar(VAR_RESULT, FALSE)
    return
}

text Inn_Text_RoomUme { "UME" }
text Inn_Text_RoomTake { "TAKE" }
text Inn_Text_RoomMatsu { "MATSU" }
text Inn_Text_RoomCancel { "CANCEL" }

// ---------------------------------------------------------------------------
// Studio slice (core). SYS-001, SYS-002.
// ---------------------------------------------------------------------------

// SYS-001: an inn rest that counts. Wraps Common_EventScript_Inn and adds one to
// VAR_REST_COUNT when the party rested. Returns VAR_RESULT TRUE on a rest, like the inn.
// Callers run setrespawn(HEAL_LOCATION_<X>) for their inn after it (when VAR_RESULT is TRUE) and set
// their own per-rest flags; nothing about a particular inn or quest lives here.
//
//   script MyInn_EventScript_Keeper {
//       call(Common_EventScript_InnRest)
//       if (var(VAR_RESULT) == TRUE) {
//           setrespawn(HEAL_LOCATION_MY_INN)
//           setflag(FLAG_MY_OWN_REST_FLAG)
//       }
//       release
//       end
//   }
script Common_EventScript_InnRest {
    call(Common_EventScript_Inn)
    if (var(VAR_RESULT) == TRUE) {
        addvar(VAR_REST_COUNT, 1)
    }
    return
}

// SYS-002: whiteout arrival. After a whiteout the player wakes at the last respawn point
// (DoWhiteOut already rested the party there). Once the fade-in is over, the field runs this
// script, which calls the one line for that respawn point. Each label below is CALLED, so it
// must end with `return`; the hook locks the player around it. The area owners replace the
// stubs: delete the stub here and define the same label in the map's scripts.pory.
// GetWhiteoutArrivalPlace (src/overworld.c) tells the places apart by heal location id, so
// moving a heal location to another map needs no change here.
script EventScript_WhiteoutArrival {
    lockall
    specialvar(VAR_RESULT, GetWhiteoutArrivalPlace)
    switch (var(VAR_RESULT)) {
        case WHITEOUT_ARRIVAL_TOKIWA_INN:
            call(TokiwaInn_EventScript_WhiteoutLine)
        case WHITEOUT_ARRIVAL_NIBI_INN:
            call(NibiInn_EventScript_WhiteoutLine)
        case WHITEOUT_ARRIVAL_MASARA_HOME:
            call(MasaraHome_EventScript_WhiteoutLine)
    }
    releaseall
    end
}

// Stub: owner tokiwa-spine replaces it (Fumiko's own line, from the script list).
script TokiwaInn_EventScript_WhiteoutLine {
    msgbox(format("FUMIKO: Back already. Sit down."))
    return
}

// Stub: owner masara replaces it. PLACEHOLDER line (Mom, before the first inn rest).
script MasaraHome_EventScript_WhiteoutLine {
    msgbox(format("MOM: Oh. You're home. Sit, sit."))
    return
}
