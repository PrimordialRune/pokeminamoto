// PewterCity_House2 (Takeshi's house) dialogue (English). Logic: scripts.pory. Translations: text.<lang>.pory
// with the same block names; see docs/engineering/map-text.md.
// Owner: nibi-town. [Nibi v3 s9] Omar's lines, [new] the studio's join. A family of five minus one: a theme, never a clue.

// NIB-113 Takeshi's younger brother, by his minerals. [Nibi v3 s9] + [new join]
text PewterCity_House2_Text_Brother {
    format("Nii-chan says don't touch the grey ones.")
}

text PewterCity_House2_Text_BrotherGift1 {
    format("Nii-chan says you can have one now.")
}

text PewterCity_House2_Text_BrotherGift2 {
    format("A grey stone goes into your pocket.")
}

// NIB-217 examines. [Nibi v3 s9]
text PewterCity_House2_Text_Kitchen1 {
    format("A pot on the stove. Meals made in bulk, enough for days.")
}

text PewterCity_House2_Text_Kitchen2 {
    format("The fridge is covered in notes, one handwriting for every sibling.")
}

text PewterCity_House2_Text_Photo1 {
    format("A grown man built like Takeshi.")
}

text PewterCity_House2_Text_Photo2 {
    format("The frame is cheap, but the photo is well kept.\pSomeone takes care of it.")
}

text PewterCity_House2_Text_Desk1 {
    format("Contracts of some kind. The last page is signed.")
}

text PewterCity_House2_Text_Desk2 {
    format("The clauses before it don't look read.")
}

text PewterCity_House2_Text_Sill1 {
    format("Minerals, ordered by color.")
}

text PewterCity_House2_Text_Sill2 {
    format("Someone spent time on this.")
}
