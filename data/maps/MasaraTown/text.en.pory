// Masara Town dialogue (English). Logic: scripts.pory. Translations: text.<lang>.pory
// with the same block names; see docs/engineering/map-text.md.
//
// Tags: [R/G] real Red/Green line (checked against pret/pokered, text/PalletTown.asm); [PR #21] kept from
// the opening events PR; [new] a join written by the studio; PLACEHOLDER = an invention for the owning thread.

text MasaraTown_Text_TownSign {
    format("MASARA TOWN\nThe pure white beginning.")
}

text MasaraTown_Text_RouteSign {
    format("ROUTE 1\nMASARA TOWN - TOKIWA CITY")
}

// MAS-002 [R/G: OAK: Hey! Wait! Don't go out! / It's unsafe! Wild POKéMON live in tall grass! ...]
text MasaraTown_Text_MAS002_HeyWait {
    format("OKIDO: Hey! Wait! Don't go out!")
}

text MasaraTown_Text_MAS002_Unsafe {
    format("OKIDO: It's unsafe! Wild POKéMON live in tall grass!")
}

text MasaraTown_Text_MAS002_YouNeedOne {
    format("You need your own POKéMON for your protection.\pI know! Here, come with me!")
}

// [new, v0.4 reduced] Ken only asks.
text MasaraTown_Text_MAS002_KenQuestion {
    format("KEN: ...Were you really going to walk in there with nothing?")
}

// MAS-202 [R/G + Notion]
text MasaraTown_Text_MAS202_HomeSign {
    format("{PLAYER}'s house")
}

text MasaraTown_Text_MAS202_OkidoHouseSign {
    format("OKIDO house")
}

text MasaraTown_Text_MAS202_LabSign {
    format("OKIDO POKéMON RESEARCH INSTITUTE")
}

// PLACEHOLDER: the Okada shop's name is not in canon beyond "the Okadas' food shop" (PR #21).
text MasaraTown_Text_MAS202_ShopSign {
    format("OKADA\nFood shop")
}

// MAS-113 Kimura's door [PR #21, kept] + the after-B1 line from the script list.
text MasaraTown_Text_Knock {
    format("(Knock, knock...)")
}

text MasaraTown_Text_KimuraGoAway {
    format("...Go away. I'm not one of Okido's errand boys.")
}

text MasaraTown_Text_KimuraGoAwayB1 {
    format("...Go away. I've nothing for Okido's errand boys.")
}

text MasaraTown_Text_KimuraNoAnswer {
    format("No answer. Someone is standing very still behind the door.")
}

text MasaraTown_Text_KimuraDoorNight {
    format("The lights are off. Nobody answers.")
}

// MAS-207
text MasaraTown_Text_KimuraBowl {
    format("An empty POKéMON food bowl, and an old leash on a hook by the door.\pThe bowl is clean. Someone still washes it.")
}

// MAS-208 [PR #21 photo by day; the night lines are from the script list / ev2 2.1]
text MasaraTown_Text_KimuraWindow {
    format("A faded photo hangs inside the window.\pA young man with a POKéMON at his feet, and someone in a lab coat beside him. Both are smiling.")
}

text MasaraTown_Text_KimuraWindowDark {
    format("Dark. Nobody's home.")
}

text MasaraTown_Text_KimuraWindowLamp {
    format("A lamp is on. Someone's home again.")
}

text MasaraTown_Text_KimuraStaring {
    format("What are you staring at.")
}

text MasaraTown_Text_KimuraDontPoke {
    format("...Don't go poking around other people's doors.")
}

// MAS-108 Fiora. Box 1 and 2 are the script list's; box 3 condenses the PR #21 speech (the rest of it,
// the ODDISH complaint, moved to Okido's lab talk).
text MasaraTown_Text_Fiora1 {
    format("Your first? I remember mine.")
}

text MasaraTown_Text_Fiora2 {
    format("SHIGERU ran past me just now. He never says hello.")
}

text MasaraTown_Text_Fiora3 {
    format("I'm Fiora, the Okadas' girl. The circuit doesn't wait, and the qualifier's in TOKIWA.\pSee you on the road. Maybe.")
}

// MAS-114 [R/G: I'm raising POKéMON too! When they get strong, they can protect me!] + [new variant]
text MasaraTown_Text_MAS114_Girl {
    format("I'm raising POKéMON too!\pWhen they get strong, they can protect me!")
}

text MasaraTown_Text_MAS114_GirlB1 {
    format("You came back. Is TOKIWA safe?")
}

// MAS-115 [R/G, the fisher by the lab]
text MasaraTown_Text_MAS115_TechMan {
    format("Technology is incredible!\pYou can now store and recall items and POKéMON as data via PC!")
}

// MAS-302 spots 1 and 2 [Notion + ev1 + new]. PLACEHOLDER positions: two bushes.
text MasaraTown_Text_MAS302_Spot1 {
    format("A scrap of ribbon is tied to a branch. A small K is inked on it.\pThe map has the same mark. One of three.")
}

text MasaraTown_Text_MAS302_Spot2 {
    format("Another ribbon, another K. Two of three.\pThe last mark on the map is by a ledge on ROUTE 1.")
}

text MasaraTown_Text_MAS302_SpotAgain {
    format("A ribbon with a K on it. You've been here already.")
}
