// Masara Town (workstream masara; studio slice). Rows: script list MAS-002, 108, 113-115, 201, 202,
// 207, 208, 302 (spots 1-2), 303 (seeds). Dialogue lives in text.en.pory.
//
// Rules for this map:
//  - Never set VAR_TEMP_F here: the door and seam coord events (data/slice_doors.inc) fire on VAR_TEMP_F == 0.
//  - Visibility is derived in ON_TRANSITION from story state (FLAG_TEMP_* hide flags clear on every warp).
//  - The old NewGameSetup (Littleroot flags and respawn) and ToLittleroot are gone: a new game starts in
//    Satoshi's room (core) and the north edge is a warp pair to Route 1 (world).
//
// VAR_MASARA_STATE (alias of VAR_LITTLEROOT_TOWN_STATE, 0x4050):
//   0 new game          1 Okido stopped the player, lab pick pending     2 starter picked, Shigeru's fight pending
//   3 fight done        4 Index scene done (parcel delivered)
// VAR_MASARA_LAB_STATE (0x4058) is the lab's own step counter (see PalletTown_ProfessorOaksLab/scripts.pory).

mapscripts MasaraTown_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        // MAS-002 actors (outdoor Okido, Ken) exist only inside their scene.
        setflag(FLAG_TEMP_2)
        setflag(FLAG_TEMP_3)
        // PR #21: Kimura goes out at night. PLACEHOLDER window 18-23: from 23 he is home and the lamp is on
        // (MAS-208); the window is whole hours as the script list requires.
        showduringhours(FLAG_HIDE_MASARA_KIMURA_NIGHT, 18, 23)
    }
}

// ---------------------------------------------------------------------------
// MAS-002 The tall grass. Step triggers on the two cells just inside the north seam while
// VAR_MASARA_STATE == 0. Okido stops at the edge of the road and does not step in; Ken runs
// past him and walks Satoshi out. No wild battle. Then the lab (MAS-003 plays there).
// ---------------------------------------------------------------------------
script MasaraTown_EventScript_MAS002_TallGrass {
    lockall
    msgbox(MasaraTown_Text_MAS002_HeyWait)
    closemessage
    applymovement(LOCALID_PLAYER, MasaraTown_Movement_PlayerFaceDown)
    waitmovement(0)
    setobjectxyperm(LOCALID_MASARA_OKIDO, 12, 3)
    setobjectxyperm(LOCALID_MASARA_KEN, 12, 4)
    clearflag(FLAG_TEMP_2)
    clearflag(FLAG_TEMP_3)
    addobject(LOCALID_MASARA_OKIDO)
    addobject(LOCALID_MASARA_KEN)
    playse(SE_PIN)
    applymovement(LOCALID_MASARA_OKIDO, MasaraTown_Movement_OkidoToTheEdge)
    getplayerxy(VAR_0x8000, VAR_0x8001)
    if (var(VAR_0x8000) == 16) {
        applymovement(LOCALID_MASARA_KEN, MasaraTown_Movement_KenRunsToEast)
    } else {
        applymovement(LOCALID_MASARA_KEN, MasaraTown_Movement_KenRunsToWest)
    }
    waitmovement(LOCALID_MASARA_OKIDO)
    waitmovement(LOCALID_MASARA_KEN)
    applymovement(LOCALID_MASARA_OKIDO, MasaraTown_Movement_OkidoFacesUp)
    waitmovement(LOCALID_MASARA_OKIDO)
    msgbox(MasaraTown_Text_MAS002_Unsafe)
    msgbox(MasaraTown_Text_MAS002_YouNeedOne)
    // [new, v0.4 reduced] Ken, a question
    msgbox(MasaraTown_Text_MAS002_KenQuestion)
    closemessage
    applymovement(LOCALID_MASARA_KEN, MasaraTown_Movement_KenWalksDown)
    applymovement(LOCALID_PLAYER, MasaraTown_Movement_PlayerFollows)
    waitmovement(LOCALID_MASARA_KEN)
    waitmovement(LOCALID_PLAYER)
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_MASARA_OKIDO)
    removeobject(LOCALID_MASARA_KEN)
    setflag(FLAG_TEMP_2)
    setflag(FLAG_TEMP_3)
    setvar(VAR_MASARA_STATE, 1)
    setvar(VAR_MASARA_LAB_STATE, 0)
    warp(MAP_PALLET_TOWN_PROFESSOR_OAKS_LAB, 6, 12)
    waitstate
    releaseall
    end
}

movement MasaraTown_Movement_PlayerFaceDown {
    face_down
}

movement MasaraTown_Movement_OkidoToTheEdge {
    walk_fast_right * 2
}

movement MasaraTown_Movement_OkidoFacesUp {
    face_up
}

// Ken passes along the lower road row and stops just below Satoshi (who stands at x 15 or 16, y 1).
movement MasaraTown_Movement_KenRunsToWest {
    walk_fast_right * 3
    walk_fast_up * 2
}

movement MasaraTown_Movement_KenRunsToEast {
    walk_fast_right * 4
    walk_fast_up * 2
}

movement MasaraTown_Movement_KenWalksDown {
    walk_down * 2
}

movement MasaraTown_Movement_PlayerFollows {
    walk_down * 2
}

// ---------------------------------------------------------------------------
// Signs. MAS-201 town sign (the "(Test) Change the time of day?" prompt is debug-only now: it lives in
// the raw block below, behind DEBUG_MENUS, and a release build calls an empty stub), MAS-202 building
// signs, route sign.
// ---------------------------------------------------------------------------
script MasaraTown_EventScript_TownSign {
    lockall
    msgbox(MasaraTown_Text_TownSign)
    call(MasaraTown_EventScript_DebugTimePrompt)
    releaseall
}

raw `
@ Test builds only (every modern build except make release): cycle the time of day so day/night
@ can be checked anywhere. Release builds get the empty stub, and no strings.
MasaraTown_EventScript_DebugTimePrompt::
#ifdef DEBUG_MENUS
	msgbox MasaraTown_DebugText_ChangeTime, MSGBOX_YESNO
	goto_if_ne VAR_RESULT, YES, MasaraTown_EventScript_DebugTimeDone
	addvar VAR_TIME_OF_DAY_OVERRIDE, 1
	goto_if_le VAR_TIME_OF_DAY_OVERRIDE, 3, MasaraTown_EventScript_DebugTimeSay
	setvar VAR_TIME_OF_DAY_OVERRIDE, 0
MasaraTown_EventScript_DebugTimeSay:
	switch VAR_TIME_OF_DAY_OVERRIDE
	case 1, MasaraTown_EventScript_DebugTimeMorning
	case 2, MasaraTown_EventScript_DebugTimeDay
	case 3, MasaraTown_EventScript_DebugTimeNight
	msgbox MasaraTown_DebugText_Clock, MSGBOX_DEFAULT
	goto MasaraTown_EventScript_DebugTimeDone

MasaraTown_EventScript_DebugTimeMorning:
	msgbox MasaraTown_DebugText_Morning, MSGBOX_DEFAULT
	goto MasaraTown_EventScript_DebugTimeDone

MasaraTown_EventScript_DebugTimeDay:
	msgbox MasaraTown_DebugText_Daytime, MSGBOX_DEFAULT
	goto MasaraTown_EventScript_DebugTimeDone

MasaraTown_EventScript_DebugTimeNight:
	msgbox MasaraTown_DebugText_Night, MSGBOX_DEFAULT

MasaraTown_EventScript_DebugTimeDone:
	closemessage
	return

MasaraTown_DebugText_ChangeTime:
	.string "(Test) Change the time of day?$"

MasaraTown_DebugText_Morning:
	.string "It's morning.$"

MasaraTown_DebugText_Daytime:
	.string "It's daytime.$"

MasaraTown_DebugText_Night:
	.string "It's night.$"

MasaraTown_DebugText_Clock:
	.string "The time follows the clock again.$"
#else
	return
#endif
`

