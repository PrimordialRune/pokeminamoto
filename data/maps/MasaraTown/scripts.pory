// ---------------------------------------------------------------------------
// MAS-302 Ken's treasure map, spots 1 and 2 (spot 3 is Route 1's R01-202, tokiwa-spine).
// An examine tutorial: with the TREASURE MAP in the bag, face the marked tile and press A.
// Without the map the tile says nothing. PLACEHOLDER positions (two bushes); art may move them.
// ---------------------------------------------------------------------------
script MasaraTown_EventScript_MAS302_Spot1 {
    lockall
    checkitem(ITEM_TREASURE_MAP)
    if (var(VAR_RESULT) == TRUE) {
        if (!flag(FLAG_HIDDEN_ITEM_MASARA_TREASURE_1)) {
            setflag(FLAG_HIDDEN_ITEM_MASARA_TREASURE_1)
            playse(SE_PIN)
            msgbox(MasaraTown_Text_MAS302_Spot1)
        } else {
            msgbox(MasaraTown_Text_MAS302_SpotAgain)
        }
    }
    releaseall
}

script MasaraTown_EventScript_MAS302_Spot2 {
    lockall
    checkitem(ITEM_TREASURE_MAP)
    if (var(VAR_RESULT) == TRUE) {
        if (!flag(FLAG_HIDDEN_ITEM_MASARA_TREASURE_2)) {
            setflag(FLAG_HIDDEN_ITEM_MASARA_TREASURE_2)
            playse(SE_PIN)
            msgbox(MasaraTown_Text_MAS302_Spot2)
        } else {
            msgbox(MasaraTown_Text_MAS302_SpotAgain)
        }
    }
    releaseall
}
