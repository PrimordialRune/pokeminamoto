// ---------------------------------------------------------------------------
// Kimura (PR #21, kept: MAS-113 door, MAS-207 bowl, MAS-208 window, the night walk). MAS-303 is
// the seed only: nothing here states the backstory.
// ---------------------------------------------------------------------------

// MAS-113. The knock: first knock sets FLAG_MASARA_KNOCKED_KIMURA. Before the Wing Badge he sends
// Okido's errand boys away (PR #21 line); after it, the script list's line. While he is out on his
// night walk the lights are off.
script MasaraTown_EventScript_KimuraDoor {
    lockall
    if (!flag(FLAG_HIDE_MASARA_KIMURA_NIGHT)) {
        msgbox(MasaraTown_Text_KimuraDoorNight)
    } elif (!flag(FLAG_MASARA_KNOCKED_KIMURA)) {
        setflag(FLAG_MASARA_KNOCKED_KIMURA)
        msgbox(MasaraTown_Text_Knock)
        if (flag(FLAG_BADGE01_GET)) {
            msgbox(MasaraTown_Text_KimuraGoAwayB1)
        } else {
            msgbox(MasaraTown_Text_KimuraGoAway)
        }
    } else {
        msgbox(MasaraTown_Text_Knock)
        if (flag(FLAG_BADGE01_GET)) {
            msgbox(MasaraTown_Text_KimuraGoAwayB1)
        } else {
            msgbox(MasaraTown_Text_KimuraNoAnswer)
        }
    }
    releaseall
}

script MasaraTown_EventScript_KimuraBowl {
    setflag(FLAG_SEEN_KIMURA_BOWL)
    msgbox(MasaraTown_Text_KimuraBowl, MSGBOX_SIGN)
}

// MAS-208. Photo by day; at night "Dark" until 23:00, then the lamp is on (he is home again).
script MasaraTown_EventScript_KimuraWindow {
    lockall
    checktimeofday
    if (var(VAR_RESULT) == TIME_OF_DAY_NITE) {
        getgamehour
        if (var(VAR_RESULT) >= 23) {
            msgbox(MasaraTown_Text_KimuraWindowLamp)
        } elif (var(VAR_RESULT) < 4) {
            msgbox(MasaraTown_Text_KimuraWindowLamp)
        } else {
            msgbox(MasaraTown_Text_KimuraWindowDark)
        }
    } else {
        setflag(FLAG_SEEN_KIMURA_PHOTO)
        msgbox(MasaraTown_Text_KimuraWindow)
    }
    releaseall
}

// At night he walks to Tokiwa for his magazine: shown only 18-23 by showduringhours in
// MAP_SCRIPT_ON_TRANSITION. (Route 1's R01-401 is tokiwa-spine's.)
script MasaraTown_EventScript_KimuraNight {
    lock
    faceplayer
    msgbox(MasaraTown_Text_KimuraStaring)
    if (flag(FLAG_SEEN_KIMURA_BOWL)) {
        msgbox(MasaraTown_Text_KimuraDontPoke)
    }
    closemessage
    applymovement(LOCALID_MASARA_KIMURA, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
}

// ---------------------------------------------------------------------------
// MAS-108 Fiora in the square (doesn't wait #1). PR #21, kept: visible from FLAG_SYS_POKEMON_GET
// until she has talked (she leaves) or tokiwa-town's first Tokiwa entry sets FLAG_HIDE_MASARA_FIORA.
// The flag is set at new game (Satoshi's room) and cleared at the starter pick (lab).
// ---------------------------------------------------------------------------
script MasaraTown_EventScript_Fiora {
    lock
    faceplayer
    setflag(FLAG_Q_FIORA_MET)
    msgbox(MasaraTown_Text_Fiora1)
    msgbox(MasaraTown_Text_Fiora2)
    msgbox(MasaraTown_Text_Fiora3)
    closemessage
    // Go round the player if they stand in her way north.
    if (var(VAR_FACING) == DIR_SOUTH) {
        applymovement(LOCALID_MASARA_FIORA, MasaraTown_Movement_FioraLeaveAround)
    } else {
        applymovement(LOCALID_MASARA_FIORA, MasaraTown_Movement_FioraLeave)
    }
    waitmovement(0)
    removeobject(LOCALID_MASARA_FIORA)
    setflag(FLAG_HIDE_MASARA_FIORA)
    release
}

movement MasaraTown_Movement_FioraLeave {
    walk_up * 7
}

movement MasaraTown_Movement_FioraLeaveAround {
    walk_left
    walk_up * 7
}

// ---------------------------------------------------------------------------
