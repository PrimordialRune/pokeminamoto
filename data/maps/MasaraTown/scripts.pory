    msgbox(MasaraTown_Text_RouteSign, MSGBOX_SIGN)
}

script MasaraTown_EventScript_MAS202_HomeSign {
    msgbox(MasaraTown_Text_MAS202_HomeSign, MSGBOX_SIGN)
