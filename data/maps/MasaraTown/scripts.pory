mapscripts MasaraTown_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (var(VAR_LITTLEROOT_INTRO_STATE) == 0) {
            call(MasaraTown_EventScript_NewGameSetup)
        }
        // Kimura only goes out at night (MasaraTown_EventScript_KimuraNight).
        showduringtime(FLAG_HIDE_MASARA_KIMURA_NIGHT, TIME_OF_DAY_NITE)
    }
}

// A new game starts here instead of in the moving truck. Put Littleroot in the
// state the truck intro, the move-in and the clock scene would leave it in, so
// its cutscenes don't fire and the route to Prof. Birch is open.
script MasaraTown_EventScript_NewGameSetup {
    checkplayergender
    if (var(VAR_RESULT) == MALE) {
        setrespawn(HEAL_LOCATION_LITTLEROOT_TOWN_BRENDANS_HOUSE_2F)
        setflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_MOM)
        setflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_TRUCK)
        setflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_TRUCK)
        setflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_RIVAL_MOM)
        setflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_RIVAL_SIBLING)
        setflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_2F_POKE_BALL)
        setvar(VAR_LITTLEROOT_HOUSES_STATE_BRENDAN, 1)
    } else {
        setrespawn(HEAL_LOCATION_LITTLEROOT_TOWN_MAYS_HOUSE_2F)
        setflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_MOM)
        setflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_TRUCK)
        setflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_TRUCK)
        setflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_RIVAL_MOM)
        setflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_RIVAL_SIBLING)
        setflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_2F_POKE_BALL)
        setvar(VAR_LITTLEROOT_HOUSES_STATE_MAY, 1)
    }
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_MOM_OUTSIDE)
    clearflag(FLAG_HIDE_LITTLEROOT_TOWN_FAT_MAN)
    setvar(VAR_LITTLEROOT_INTRO_STATE, 7)
    setvar(VAR_LITTLEROOT_TOWN_STATE, 1)
}

script MasaraTown_EventScript_TownSign {
    lockall
    msgbox(MasaraTown_Text_TownSign)
    // Test builds: cycle the time of day so day/night can be checked anywhere.
    msgbox(MasaraTown_Text_TestChangeTime, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        addvar(VAR_TIME_OF_DAY_OVERRIDE, 1)
        if (var(VAR_TIME_OF_DAY_OVERRIDE) > 3) {
            setvar(VAR_TIME_OF_DAY_OVERRIDE, 0)
        }
        switch (var(VAR_TIME_OF_DAY_OVERRIDE)) {
            case 1: msgbox(MasaraTown_Text_TestMorning)
            case 2: msgbox(MasaraTown_Text_TestDaytime)
            case 3: msgbox(MasaraTown_Text_TestNight)
            default: msgbox(MasaraTown_Text_TestClock)
        }
        // The field picks the change up by itself at the end of the frame.
        closemessage
    }
    releaseall
}

script MasaraTown_EventScript_RouteSign {
    msgbox(MasaraTown_Text_RouteSign, MSGBOX_SIGN)
}

script MasaraTown_EventScript_ToLittleroot {
    lockall
    // Fiora leaves the same morning the player does, talked to or not.
    setflag(FLAG_HIDE_MASARA_FIORA)
    warp(MAP_LITTLEROOT_TOWN, 10, 18)
    waitstate
    releaseall
}

// ---------------------------------------------------------------------------
// Opening events (design: masara-tokiwa-events-v2.md). The logic is here; the
// dialogue of the MasaraTown_Text_* labels is in text.en.pory (translations in
// text.<lang>.pory, see docs/engineering/map-text.md).
//
// Save cost: flags 0x493-0x498, no vars.
// ---------------------------------------------------------------------------

// Old Kimura: he won't open the door. The bowl, the leash and the photo are
// the seeds; his payoff is a mid-game event.
script MasaraTown_EventScript_KimuraDoor {
    lockall
    if (!flag(FLAG_HIDE_MASARA_KIMURA_NIGHT)) {
        msgbox(MasaraTown_Text_KimuraDoorNight)
    } elif (!flag(FLAG_MASARA_KNOCKED_KIMURA)) {
        setflag(FLAG_MASARA_KNOCKED_KIMURA)
        msgbox(MasaraTown_Text_Knock)
        msgbox(MasaraTown_Text_KimuraGoAway)
    } else {
        msgbox(MasaraTown_Text_Knock)
        msgbox(MasaraTown_Text_KimuraNoAnswer)
    }
    releaseall
}

script MasaraTown_EventScript_KimuraBowl {
    setflag(FLAG_SEEN_KIMURA_BOWL)
    msgbox(MasaraTown_Text_KimuraBowl, MSGBOX_SIGN)
}

script MasaraTown_EventScript_KimuraWindow {
    setflag(FLAG_SEEN_KIMURA_PHOTO)
    msgbox(MasaraTown_Text_KimuraWindow, MSGBOX_SIGN)
}

// At night he walks to Tokiwa for his magazine: shown only at night by
// showduringtime in MAP_SCRIPT_ON_TRANSITION.
script MasaraTown_EventScript_KimuraNight {
    lock
    faceplayer
    msgbox(MasaraTown_Text_KimuraStaring)
    if (flag(FLAG_SEEN_KIMURA_BOWL)) {
        msgbox(MasaraTown_Text_KimuraDontPoke)
    }
    closemessage
    applymovement(LOCALID_MASARA_KIMURA, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
}

// Fiora: leaving for the circuit the same morning. After the talk she walks
// up the north road toward Route 1 and is gone.
script MasaraTown_EventScript_Fiora {
    lock
    faceplayer
    msgbox(MasaraTown_Text_Fiora)
    closemessage
    // Go round the player if they stand in her way north.
    if (var(VAR_FACING) == DIR_SOUTH) {
        applymovement(LOCALID_MASARA_FIORA, MasaraTown_Movement_FioraLeaveAround)
    } else {
        applymovement(LOCALID_MASARA_FIORA, MasaraTown_Movement_FioraLeave)
    }
    waitmovement(0)
    removeobject(LOCALID_MASARA_FIORA)
    setflag(FLAG_HIDE_MASARA_FIORA)
    release
}

movement MasaraTown_Movement_FioraLeave {
    walk_up * 7
}

movement MasaraTown_Movement_FioraLeaveAround {
    walk_left
    walk_up * 7
}

// Okido outside his institute. The "something sealed" line seeds the Special
// (it belongs in the starter scene once the Kanto lab exists). He changes the
// subject if the player has seen the photo in Kimura's window.
script MasaraTown_EventScript_Okido {
    lock
    faceplayer
    if (!flag(FLAG_MASARA_OKIDO_SEALED)) {
        setflag(FLAG_MASARA_OKIDO_SEALED)
        msgbox(MasaraTown_Text_OkidoSealed)
    } else {
        msgbox(MasaraTown_Text_OkidoSealedAgain)
    }
    if (flag(FLAG_SEEN_KIMURA_PHOTO)) {
        msgbox(MasaraTown_Text_OkidoChangesSubject)
    }
    release
}

// Nanami tends her herbs by the Okido house. Once the player has seen
// Kimura's bowl she remembers what he used to buy.
script MasaraTown_EventScript_Nanami {
    lock
    faceplayer
    msgbox(MasaraTown_Text_NanamiHerbs)
    if (flag(FLAG_SEEN_KIMURA_BOWL)) {
        msgbox(MasaraTown_Text_NanamiKimura)
    }
    closemessage
    applymovement(LOCALID_MASARA_NANAMI, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
}

// Okada food shop: the mother outside asks after Fiora, the father answers
// from inside and pretends not to care.
script MasaraTown_EventScript_OkadaMother {
    lock
    faceplayer
    if (flag(FLAG_SYS_POKEMON_GET)) {
        msgbox(MasaraTown_Text_OkadaMotherTrainer)
        msgbox(MasaraTown_Text_OkadaFatherTrainer)
    } elif (!flag(FLAG_HIDE_MASARA_FIORA)) {
        msgbox(MasaraTown_Text_OkadaMotherFioraHere)
        msgbox(MasaraTown_Text_OkadaFatherFioraHere)
    } else {
        msgbox(MasaraTown_Text_OkadaMotherFioraGone)
        msgbox(MasaraTown_Text_OkadaFatherFioraGone)
    }
    release
}
