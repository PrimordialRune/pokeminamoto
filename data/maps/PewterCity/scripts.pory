// NIB-201's sign carries the ticket price and the laminated notice; reading it starts NIB-302 (var 0 to 1).
script PewterCity_EventScript_MuseumSign {
    lockall
    msgbox(PewterCity_Text_MuseumSign)
    msgbox(PewterCity_Text_MuseumSignNotice)
    if (var(VAR_Q_FOSSILS) == 0) {
        setvar(VAR_Q_FOSSILS, 1)
    }
    releaseall
    end
}

