// NIB-215 / NIB-221: the CVS outer board. From B2 the fossil-thief notice replaces the municipal ones.
script PewterCity_EventScript_CVSBoard {
    if (flag(FLAG_BADGE02_GET)) {
        msgbox(PewterCity_Text_BoardThieves, MSGBOX_SIGN)
    } else {
        msgbox(PewterCity_Text_BoardDefault, MSGBOX_SIGN)
    }
    end
}

// ---------------------------------------------------------------------------------------------------------------
// NIB-106 + NIB-305 steps 1 and 2 (either order). VAR_Q_POET: 0 none, 1 stone shown, 2 Onix told, 3 both.
// The grey stone is a flag (FLAG_Q_GREY_STONE), not an item: PLACEHOLDER, a real key item needs a frozen-file change
// (requests.md). States: stone step, Onix step, done, default.
script PewterCity_EventScript_Poet {
    lock
    faceplayer
    if (flag(FLAG_Q_GREY_STONE)) {
        if (var(VAR_Q_POET) == 0 || var(VAR_Q_POET) == 2) {
            goto(PewterCity_EventScript_PoetStone)
        }
    }
    if (flag(FLAG_BADGE02_GET)) {
        if (var(VAR_Q_POET) == 0 || var(VAR_Q_POET) == 1) {
            goto(PewterCity_EventScript_PoetOnix)
        }
    }
    if (var(VAR_Q_POET) == 3) {
        msgbox(PewterCity_Text_PoetDone)
    } else {
        msgbox(PewterCity_Text_PoetDefault)
    }
    release
    end
}

script PewterCity_EventScript_PoetStone {
    msgbox(PewterCity_Text_PoetStone1)
    msgbox(PewterCity_Text_PoetStone2)
    msgbox(PewterCity_Text_PoetStone3)
    if (var(VAR_Q_POET) == 0) {
        setvar(VAR_Q_POET, 1)
    } else {
        setvar(VAR_Q_POET, 3)
    }
    release
    end
}

// Point to the first / Point to the second: a yes/no (YES = the first line) until core adds a two-option multichoice.
script PewterCity_EventScript_PoetOnix {
    msgbox(PewterCity_Text_PoetOnix1)
    msgbox(PewterCity_Text_PoetOnixLines)
    msgbox(PewterCity_Text_PoetPoint, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        setflag(FLAG_Q_POET_A)
        msgbox(PewterCity_Text_PoetPickedA)
    } else {
        setflag(FLAG_Q_POET_B)
        msgbox(PewterCity_Text_PoetPickedB)
    }
    if (var(VAR_Q_POET) == 0) {
        setvar(VAR_Q_POET, 2)
    } else {
        setvar(VAR_Q_POET, 3)
    }
    release
    end
}
