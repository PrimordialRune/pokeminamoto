// TOK-212 The CVS board: Omura's notice starts the Sandshrew quest (C2: VAR_Q_SANDSHREW 0 -> 1).
// The notice is up while the var is 3 or less; once it is handed over, kept, fainted or missed (4-7) the board
// holds only old flyers.
script TokiwaCity_EventScript_CVSBoard {
    lockall
    if (var(VAR_Q_SANDSHREW) <= 3) {
        setflag(FLAG_SEEN_OMURA_NOTICE)
        if (var(VAR_Q_SANDSHREW) == 0) {
            setvar(VAR_Q_SANDSHREW, 1)
        }
        msgbox(TokiwaCity_Text_TOK212_Notice)
    } else {
        msgbox(TokiwaCity_Text_TOK212_Old)
    }
    releaseall
    end
}
