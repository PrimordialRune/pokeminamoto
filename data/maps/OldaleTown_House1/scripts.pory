// Oldale's house doubles as the test inn for the town-life toolkit
// (docs/engineering/town-life-toolkit.md) until the Kanto inns exist.
mapscripts OldaleTown_House1_MapScripts {}

script OldaleTown_House1_EventScript_Innkeeper {
    call(Common_EventScript_Inn)
    if (var(VAR_RESULT) == TRUE) {
        setrespawn(HEAL_LOCATION_OLDALE_TOWN_INN)
    }
    release
    end
}

// Left in the room after a TAKE or MATSU stay (see data/scripts/inn.pory)
script OldaleTown_House1_EventScript_TakeRoomItem {
    finditem(ITEM_SUPER_POTION)
    end
}
