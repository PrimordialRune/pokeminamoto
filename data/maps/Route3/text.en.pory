text Route3_Text_EdgeSign {
    format("Route 3\nNibi - Otsukimi")
}

// PLACEHOLDER (thread "Define Minamoto narrative direction", Q112): hiker at the Route 3 rockfall wall.
text Route3_Text_WallHiker {
    format("The Otsukimi road's shut past here. Rockfall. They say after the snow.")
}

// R03-501. [R/G, verify] PLACEHOLDER party in trainers.party (thread "Design movesets and encounters").
