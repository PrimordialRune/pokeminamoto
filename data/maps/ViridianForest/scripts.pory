// Tokiwa Forest (north). Rows FOR-001, 002, 003, 101-104, 201-206, 501-503, W1 (wild table: lab).
// Contracts: C1 (FOR-003, Ken has the tag), R22-501's expiry (set here on the first entry).
// VAR_FOREST_STATE: 0 Ken's clearing scene still to play, 1 played (FLAG_Q_KEN1_DONE).

mapscripts ViridianForest_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        // R22-501 expiry (PLACEHOLDER Q100, the script list's invention): entering the forest with
        // Shigeru unfought hides him for good and Ken's scene gets one extra box.
        if (var(VAR_ROUTE22_STATE) == 0) {
            setvar(VAR_ROUTE22_STATE, 2)
            setflag(FLAG_Q_R22_SKIPPED)
        }
        // Ken waits in the clearing until the scene has played. If the bag was full at FOR-003 he waits on.
        setflag(FLAG_HIDE_FOREST_KEN)
        if (var(VAR_FOREST_STATE) == 0) {
            clearflag(FLAG_HIDE_FOREST_KEN)
        }
        if (var(VAR_FOREST_STATE) == 1 && var(VAR_Q_TAG) == 1 && flag(FLAG_Q_KEN1_DONE) && !flag(FLAG_Q_TAG_CAUGHT) && !flag(FLAG_Q_TAG_KO)) {
            // Tag still owed (bag was full): Ken stays in the clearing.
            clearflag(FLAG_HIDE_FOREST_KEN)
        }
    }
}

