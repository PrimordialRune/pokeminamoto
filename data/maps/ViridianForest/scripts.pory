// ---------------------------------------------------------------------------
// FOR-501-503 Bug Catchers [R/G pokered parties, PLACEHOLDER levels owned by lab]. These scripts must start
// with the trainerbattle command (sight triggers read it directly). The canon line is shown right after the
// battle; later talks give the invented second line (FOR-104, FOR-103); Bug Catcher 3 keeps his canon line.
// ---------------------------------------------------------------------------

script Forest_EventScript_BugCatcher1 {
    trainerbattle_single(TRAINER_BUG_CATCHER_FOREST_1, Forest_Text_BC1Intro, Forest_Text_BC1Defeat, Forest_EventScript_BC1Won)
    msgbox(Forest_Text_BC1Second, MSGBOX_AUTOCLOSE)
    end
}

script Forest_EventScript_BC1Won {
    msgbox(Forest_Text_BC1After)
    releaseall
    end
}

script Forest_EventScript_BugCatcher2 {
