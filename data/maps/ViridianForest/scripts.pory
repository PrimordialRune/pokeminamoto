// ---------------------------------------------------------------------------
// FOR-003 + FOR-002: Ken in the clearing before the north gate. Every player crosses row 12 at x 4 or 5,
// so the scene always plays once. The result is free: no whiteout (core's early-rival mode, PLACEHOLDER Q96
// for the heal and its one line). Ken's party is the leftover starter Lv 8 + Metapod Lv 7 (OQ13 PLACEHOLDER).
// ---------------------------------------------------------------------------

script Forest_EventScript_KenTriggerLeft {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, Forest_Movement_StepRightFaceUp)
    waitmovement(0)
    goto(Forest_EventScript_KenScene)
}

script Forest_EventScript_KenTriggerMid {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, Forest_Movement_FaceUp)
    waitmovement(0)
    goto(Forest_EventScript_KenScene)
}

script Forest_EventScript_KenScene {
    // FOR-003 first: the tag, when Okido asked for it and the player never got it.
    if (var(VAR_Q_TAG) == 1) {
        msgbox(Forest_Text_KenTag)
        giveitem(ITEM_OLD_EAR_TAG)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_Q_TAG_KEN)
            setvar(VAR_Q_TAG, 2)
            msgbox(Forest_Text_TagReads)
        } else {
            // Bag full: Ken keeps it and waits (his talk script hands it over later).
            msgbox(Forest_Text_KenTagLater)
        }
    }
    msgbox(Forest_Text_KenSketches)
    if (flag(FLAG_Q_R22_SKIPPED)) {
        msgbox(Forest_Text_KenShigeru)
    }
    goto(Forest_EventScript_KenFight)
}

script Forest_EventScript_KenFight {
    switch (var(VAR_STARTER_MON)) {
        case 0:
            trainerbattle_early_rival(TRAINER_KEN_FOREST_1, Forest_Text_KenIntro, Forest_Text_KenDefeated, Forest_Text_KenVictory, Forest_EventScript_KenAfter)
        case 1:
            trainerbattle_early_rival(TRAINER_KEN_FOREST_2, Forest_Text_KenIntro, Forest_Text_KenDefeated, Forest_Text_KenVictory, Forest_EventScript_KenAfter)
        default:
            trainerbattle_early_rival(TRAINER_KEN_FOREST_3, Forest_Text_KenIntro, Forest_Text_KenDefeated, Forest_Text_KenVictory, Forest_EventScript_KenAfter)
    }
    releaseall
    end
}

// After the fight, VAR_RESULT 1 (won) or 0 (lost). Read it first.
script Forest_EventScript_KenAfter {
    setflag(FLAG_Q_KEN1_DONE)
    setvar(VAR_FOREST_STATE, 1)
    if (var(VAR_RESULT) == 1) {
        setflag(FLAG_Q_KEN1_WIN)
    } else {
        // PLACEHOLDER (Q96): the line over core's free heal.
        msgbox(Forest_Text_KenSit)
    }
    if (var(VAR_Q_TAG) != 1) {
        applymovement(LOCALID_FOREST_KEN, Forest_Movement_KenLeaves)
        waitmovement(0)
        removeobject(LOCALID_FOREST_KEN)
        setflag(FLAG_HIDE_FOREST_KEN)
    }
    releaseall
    end
}

// Ken's own script: only live while the tag is still owed (bag was full); otherwise he is gone.
script Forest_EventScript_Ken {
    lock
    faceplayer
    if (var(VAR_Q_TAG) == 1) {
        msgbox(Forest_Text_KenTag)
        giveitem(ITEM_OLD_EAR_TAG)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_Q_TAG_KEN)
            setvar(VAR_Q_TAG, 2)
            msgbox(Forest_Text_TagReads)
            applymovement(LOCALID_FOREST_KEN, Forest_Movement_KenLeaves)
            waitmovement(0)
            removeobject(LOCALID_FOREST_KEN)
            setflag(FLAG_HIDE_FOREST_KEN)
        } else {
            msgbox(Forest_Text_KenTagLater)
        }
    } else {
        msgbox(Forest_Text_KenSketchesAgain)
    }
    release
    end
}

movement Forest_Movement_StepRightFaceUp {
    walk_right
    face_up
}

movement Forest_Movement_FaceUp {
    face_up
}

movement Forest_Movement_KenLeaves {
    walk_up
    walk_up
}
