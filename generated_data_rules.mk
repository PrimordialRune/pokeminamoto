# Data tables generated by tools in tools/ from text sources (see each tool's README).
# The outputs are gitignored; `make generated` (run before every build) writes them.

# Species: one record per species in src/data/species/ -> every per-species C table
SPECIESGEN       := python3 tools/speciesgen/speciesgen.py
SPECIESGEN_STAMP := $(BUILD_DIR)/speciesgen.stamp
SPECIESGEN_OUT   := $(shell $(SPECIESGEN) --list)
SPECIES_RECORDS  := src/data/species/species.txt $(wildcard src/data/species/*.json)

AUTO_GEN_TARGETS += $(SPECIESGEN_OUT)

# speciesgen rewrites only the outputs whose text changed, so the stamp records the run
$(SPECIESGEN_STAMP): $(SPECIES_RECORDS) $(wildcard tools/speciesgen/*.py)
	$(SPECIESGEN)
	@mkdir -p $(@D) && touch $@

$(SPECIESGEN_OUT): $(SPECIESGEN_STAMP)
	@test -f $@ || $(SPECIESGEN)
